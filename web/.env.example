# Spreadsheet to read/write. Find this in the Sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_ID=

# Service-account credentials. Create one in GCP, download the JSON key, then:
#   - copy `client_email` here
#   - copy `private_key` here, keeping the literal \n escape sequences (do NOT replace with real newlines).
# IMPORTANT: share the target Sheet with this email as Editor, otherwise reads/writes will 403.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Must match the Apps Script LEADS_SHEET_NAME script property (default: Leads).
LEADS_SHEET_NAME=Leads

# HTTP Basic Auth gate. Choose anything; the browser will prompt the first visitor.
WEB_APP_USER=admin
WEB_APP_PASSWORD=change-me
